{
  "manifest_version": 3,
  "name": "Thinkific Field Modifier",
  "description": "Scan a Thinkific sign-up page and build custom field modifications",
  "version": "1.33.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.thinkific.com/*",
    "https://*.thinkific-staging.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Thinkific Field Modifier",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "editor.html",
        "highlight.min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}